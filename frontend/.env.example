# Leave unset for dev — browser uses same-origin and Vite proxies /api → FastAPI (port 9000).
# Only set for production builds, e.g. VITE_API_BASE_URL=https://api.example.com
VITE_APP_ENV=development

# Backend CORS (must match UI origin when not using Vite proxy)
# SECURITY__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
