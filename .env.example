# Copy to .env and adjust. Every setting the app reads is listed here.
# Nested settings use a double underscore: SECTION__FIELD.
# Never commit .env.

# --- Application ------------------------------------------------------------
# development | test | staging | production
# In staging and production the app refuses to start with unsafe settings, sends HSTS and hides
# the API docs (see app/core/config.py).
ENVIRONMENT=development
DEBUG=false
APP_NAME=User Management API

# --- Docker Compose (used only by `make run` / docker-compose.yml) -----------
# Compose builds DATABASE__URL and REDIS__URL for the app container from these values, so
# inside Compose the two *__URL settings below are overridden. Ports are bound to 127.0.0.1.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=usermgmt
REDIS_PASSWORD=redis-dev-password
APP_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Database (PostgreSQL) --------------------------------------------------
# Staging/production: must include a password (and not the default postgres:postgres).
DATABASE__URL=postgresql+asyncpg://postgres:postgres@localhost:5432/usermgmt
DATABASE__POOL_SIZE=5
DATABASE__MAX_OVERFLOW=5
DATABASE__POOL_TIMEOUT_SECONDS=10
# Give up connecting after this many seconds when the database host doesn't answer.
DATABASE__CONNECT_TIMEOUT_SECONDS=5
DATABASE__ECHO=false

# --- Redis ------------------------------------------------------------------
# Staging/production: must include a password, e.g. redis://:<password>@host:6379/0
# (use rediss:// for TLS).
REDIS__URL=redis://:redis-dev-password@localhost:6379/0

# --- JWT --------------------------------------------------------------------
# Staging/production require a random secret: at least 32 characters, not repetitive, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT__SECRET_KEY=insecure-development-secret-change-me-before-production
# One of HS256, HS384, HS512.
JWT__ALGORITHM=HS256

# --- CORS -------------------------------------------------------------------
# JSON list of allowed browser origins, e.g. ["https://app.example.com"]. Empty = CORS disabled.
# "*" together with credentials is rejected at startup.
CORS__ALLOW_ORIGINS=[]
CORS__ALLOW_CREDENTIALS=true

# --- Logging ----------------------------------------------------------------
LOG__LEVEL=INFO
# Log records waiting to be written; when full (stdout stuck), new ones are dropped and counted.
LOG__QUEUE_SIZE=10000

# --- Health checks ----------------------------------------------------------
HEALTH__CHECK_TIMEOUT_SECONDS=2.0
# Readiness results are reused for this many seconds (protects the DB from probe floods). 0 = off.
HEALTH__CACHE_SECONDS=1.0

# --- Server (read by uvicorn, not by the app) --------------------------------
# Comma-separated proxy IPs whose X-Forwarded-For header is trusted.
# Set this to your load balancer's address; never "*" on a public network.
FORWARDED_ALLOW_IPS=127.0.0.1

# --- Tokens (JWT) ---
# Who issues the tokens (`iss`); tokens from any other issuer are refused.
JWT__ISSUER=user-management-api
# Who the tokens are for (`aud`); give each deployment its own value.
JWT__AUDIENCE=user-management-clients
# Access token lifetime in seconds (60-3600).
JWT__ACCESS_TTL_SECONDS=900
# Clock difference tolerated between servers, in seconds.
JWT__LEEWAY_SECONDS=10

# --- Authentication ---
# false hides POST /api/v1/auth/signup (invite-only products).
AUTH__SIGNUP_ENABLED=true
# Session limits (ISO 8601 durations). The defaults are ASVS level 2, which needs both:
# idle limit — a refresh token lives this long, and each refresh issues a new one...
AUTH__REFRESH_TTL=PT30M
# ...and absolute limit — no refresh beyond this long after the first login.
# Longer values (e.g. P14D / P30D) mean ASVS level 1 for sessions (ADR-0011).
# AUTH__REFRESH_TTL must be at least twice JWT__ACCESS_TTL_SECONDS.
AUTH__SESSION_MAX_AGE=PT12H
# Ending other devices' sessions and logout-all need the current password (ASVS V3.3.4).
AUTH__REAUTH_TO_END_SESSIONS=true
# Failed logins before the account is locked, and for how long.
AUTH__LOCKOUT_THRESHOLD=5
AUTH__LOCKOUT_MINUTES=15
# allow_multiple | replace_all | limit_sessions | replace_same_device
AUTH__SESSION_STRATEGY=allow_multiple
# Used by limit_sessions.
AUTH__MAX_SESSIONS=5
# Password hashes running at once (each uses 64 MiB).
AUTH__PASSWORD_HASH_WORKERS=4
