# FastAPI User Management - Environment Configuration
# Copy this file to .env and modify values as needed

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
APP__NAME=FastAPI User Management
APP__VERSION=1.0.0
APP__DESCRIPTION=Role-based multi-tenant user management system
APP__DEBUG=false
APP__HOST=localhost
APP__PORT=9000
APP__RELOAD=false
APP__ENVIRONMENT=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB__URL=mysql+pymysql://root:Sandhya%40332@localhost:3306/fastapi_users
DB__ECHO=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20

# =============================================================================
# REDIS CONFIGURATION
# =============================================================================
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=
REDIS__SOCKET_CONNECT_TIMEOUT=5
REDIS__SOCKET_TIMEOUT=5
REDIS__RETRY_ON_TIMEOUT=true

# =============================================================================
# JWT CONFIGURATION
# =============================================================================
# IMPORTANT: Change this secret key in production!
JWT__SECRET_KEY=your-super-secret-key-change-this-in-production-must-be-at-least-32-chars
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=5
JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# RATE LIMITING CONFIGURATION
# =============================================================================
# Endpoint-specific rate limits (requests per time window)
RATE_LIMIT__ENDPOINT_LIMITS__USERS_LIST__MINUTE=5
RATE_LIMIT__ENDPOINT_LIMITS__USERS_LIST__HOUR=50
RATE_LIMIT__ENDPOINT_LIMITS__USER_DETAIL__MINUTE=20
RATE_LIMIT__ENDPOINT_LIMITS__USER_DETAIL__HOUR=200
RATE_LIMIT__ENDPOINT_LIMITS__SESSIONS__MINUTE=10
RATE_LIMIT__ENDPOINT_LIMITS__SESSIONS__HOUR=100
RATE_LIMIT__ENDPOINT_LIMITS__SESSION_REVOKE__MINUTE=5
RATE_LIMIT__ENDPOINT_LIMITS__SESSION_REVOKE__HOUR=50
RATE_LIMIT__ENDPOINT_LIMITS__LOGIN__MINUTE=10
RATE_LIMIT__ENDPOINT_LIMITS__LOGIN__HOUR=100
RATE_LIMIT__ENDPOINT_LIMITS__REFRESH__MINUTE=20
RATE_LIMIT__ENDPOINT_LIMITS__REFRESH__HOUR=200
RATE_LIMIT__ENDPOINT_LIMITS__SIGNUP__MINUTE=5
RATE_LIMIT__ENDPOINT_LIMITS__SIGNUP__HOUR=50

# Global IP limits (DDoS protection)
RATE_LIMIT__GLOBAL_IP_LIMITS__MINUTE=1000
RATE_LIMIT__GLOBAL_IP_LIMITS__HOUR=10000
RATE_LIMIT__GLOBAL_IP_LIMITS__DAY=100000

# Rate limiting behavior
RATE_LIMIT__FAIL_OPEN=true
RATE_LIMIT__ENABLE_USER_LIMITS=true
RATE_LIMIT__ENABLE_IP_LIMITS=true

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG__LEVEL=INFO
LOG__LOG_DIR=logs
LOG__MAX_FILE_SIZE=10485760
LOG__BACKUP_COUNT=5
LOG__ENABLE_CONSOLE=true
LOG__ENABLE_FILE=true
LOG__ENABLE_JSON=true
LOG__ROTATION_ENABLED=true
LOG__ROTATION_SCHEDULE=daily
LOG__RETENTION_DAYS=30

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================
SECURITY__ENABLE_CORS=true
SECURITY__CORS_ORIGINS=["*"]
SECURITY__ENABLE_HTTPS_REDIRECT=false
SECURITY__SESSION_TIMEOUT_MINUTES=30
SECURITY__MAX_LOGIN_ATTEMPTS=5
SECURITY__LOCKOUT_DURATION_MINUTES=15

# =============================================================================
# PRODUCTION OVERRIDES (uncomment for production)
# =============================================================================
# APP__ENVIRONMENT=production
# APP__DEBUG=false
# APP__RELOAD=false
# LOG__LEVEL=WARNING
# SECURITY__ENABLE_HTTPS_REDIRECT=true
# SECURITY__CORS_ORIGINS=["https://yourdomain.com"]
# JWT__SECRET_KEY=your-production-secret-key-must-be-very-long-and-secure
# REDIS__PASSWORD=your-redis-password
# DB__URL=mysql+pymysql://prod_user:prod_password@prod_host:3306/prod_db
