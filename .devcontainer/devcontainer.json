{
  "name": "FastAPI User Management (Codespaces)",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20"
    }
  },
  "forwardPorts": [5173, 9000, 3306, 6379],
  "portsAttributes": {
    "5173": {
      "label": "Web UI",
      "onAutoForward": "openBrowser",
      "visibility": "public"
    },
    "9000": {
      "label": "FastAPI API",
      "onAutoForward": "notify",
      "visibility": "public"
    },
    "3306": {
      "label": "MySQL",
      "visibility": "private"
    },
    "6379": {
      "label": "Redis",
      "visibility": "private"
    }
  },
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",
  "remoteEnv": {
    "GIT_REPOSITORY_URL": "https://github.com/Husky1711/fastapi-user-management.git",
    "GIT_BRANCH": "feature/codespaces-local-db",
    "CODESPACES_CONFIG": "codespaces.yaml",
    "CODESPACES_API_PORT": "9000",
    "CODESPACES_UI_PORT": "5173"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"
      }
    }
  }
}
