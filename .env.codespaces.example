# Codespaces environment — copy to .env by setup.sh
# Git: https://github.com/Husky1711/fastapi-user-management.git
# Branch: feature/codespaces-local-db

APP__NAME=FastAPI User Management
APP__VERSION=1.0.0
APP__DESCRIPTION=Role-based multi-tenant user management system
APP__DEBUG=true
APP__HOST=0.0.0.0
APP__PORT=9000
APP__RELOAD=true
APP__ENVIRONMENT=development

# Local MySQL (docker-compose.codespaces.yml)
DB__URL=mysql+pymysql://fastapi:fastapi@localhost:3306/fastapi_users
DB__ECHO=false
DB__POOL_SIZE=10
DB__MAX_OVERFLOW=20

# Local Redis (docker-compose.codespaces.yml)
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=

JWT__SECRET_KEY=your-super-secret-key-change-this-in-production-must-be-at-least-32-chars
JWT__ALGORITHM=HS256
JWT__ACCESS_TOKEN_EXPIRE_MINUTES=5
JWT__REFRESH_TOKEN_EXPIRE_DAYS=7

LOG__LEVEL=INFO
LOG__ENABLE_CONSOLE=true
LOG__ENABLE_FILE=false

SECURITY__ENABLE_HTTPS_REDIRECT=false
SECURITY__ENABLE_CORS=true
SECURITY__CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
SECURITY__ALLOW_PUBLIC_SIGNUP=true
SECURITY__ALLOW_DEBUG_AUTH=true

AUTH_COOKIE__USE_HTTPONLY_REFRESH=true
AUTH_COOKIE__LEGACY_JSON_REFRESH=true
AUTH_COOKIE__PATH=/api/v1
AUTH_COOKIE__SECURE=false
AUTH_COOKIE__SAMESITE=lax

EMAIL__ENABLE_EMAILS=false

# Optional Neon — uncomment and set instead of DB__URL:
# DATABASE_URL=postgresql+psycopg://user:pass@ep-xxx.neon.tech/neondb?sslmode=require
