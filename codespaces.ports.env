# Codespaces port map — single source of truth
# Keep in sync with codespaces.yaml and .devcontainer/devcontainer.json
#
# Public URLs (in browser):
#   UI:  https://${CODESPACE_NAME}-5173.app.github.dev
#   API: https://${CODESPACE_NAME}-9000.app.github.dev

CODESPACES_API_PORT=9000
CODESPACES_UI_PORT=5173
CODESPACES_MYSQL_PORT=3306
CODESPACES_REDIS_PORT=6379

# Written into .env on setup (backend)
APP__HOST=0.0.0.0
APP__PORT=9000

# Vite dev server (frontend)
VITE_DEV_PORT=5173
VITE_API_PROXY_TARGET=http://localhost:9000
